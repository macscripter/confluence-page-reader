    },
    {
      "name": "Jira write",
      "item": [
        {
          "name": "Create issue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "description": "Create an issue. issue_type defaults to Task. description is plain text (Cloud: converted to ADF, blank line = new paragraph; Data Center: wiki markup as-is). assignee takes a username/accountId or an email/display name. parent_key makes a sub-task. extra_fields is a raw Jira fields object for anything else, e.g. custom fields.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_key\": \"{{projectKey}}\",\n  \"summary\": \"Created from Postman\",\n  \"issue_type\": \"Task\",\n  \"description\": \"First paragraph.\\n\\nSecond paragraph.\",\n  \"priority\": \"Medium\",\n  \"labels\": [\n    \"postman\"\n  ],\n  \"extra_fields\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create sub-task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "description": "Sub-task under issueKey. The issue_type must be one of the project's sub-task types (see Project issue types).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_key\": \"{{projectKey}}\",\n  \"summary\": \"Sub-task from Postman\",\n  \"issue_type\": \"Sub-task\",\n  \"parent_key\": \"{{issueKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update issue",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueKey}}"
              ]
            },
            "description": "Change only the fields you send. labels replaces the whole set. PUT is accepted as an alias. To change the status use the transition request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Updated summary\",\n  \"priority\": \"High\",\n  \"labels\": [\n    \"postman\",\n    \"updated\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueKey}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueKey}}",
                "comments"
              ]
            },
            "description": "Post a comment. Same text handling as description. Returns 201 with comment_id; copy it into the commentId variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Comment from Postman.\\nSecond line.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Edit comment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueKey}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueKey}}",
                "comments",
                "{{commentId}}"
              ]
            },
            "description": "Edit a comment in place. Only comments the token owner may edit, in practice their own.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Edited comment text.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete comment (preview)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueKey}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueKey}}",
                "comments",
                "{{commentId}}"
              ]
