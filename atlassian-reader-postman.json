              "raw": "{{baseUrl}}/projects?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Projects visible to the token owner: key, name, id, type."
          }
        },
        {
          "name": "Project issue types",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Atlassian-Url",
                "value": "{{jiraUrl}}"
              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
