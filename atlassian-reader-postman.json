              },
              {
                "key": "X-Atlassian-Token",
                "value": "{{atlassianToken}}"
              },
              {
                "key": "X-Atlassian-Email",
                "value": "{{atlassianEmail}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueKey}}/transitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueKey}}",
                "transitions"
              ]
            },
            "description": "Workflow transitions available from the current status: id, name, to_status. Use one with the transition request."
          }
        },
        {
